{
  "manifest_version": 3,
  "name": "PRep",
  "version": "0.1.0",
  "description": "Click a changed code block in any GitHub PR and get quizzed on what it does. Powered by Portkey.",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["selectors.js", "card.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PRep — settings",
    "default_popup": "popup.html"
  }
}
